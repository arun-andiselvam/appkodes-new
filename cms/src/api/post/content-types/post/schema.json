{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post",
    "description": "One published article. Mirrors the Post type in lib/posts.ts, and the two have to be changed together. Field order here is the order of the form, so write first and keep the housekeeping at the bottom."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 70
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": ["/resources/integration-guides", "/resources/cost-reduction-strategies"],
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true,
      "maxLength": 220
    },
    "body": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "required": true,
      "options": {
        "preset": "Hitasoft article"
      }
    },
    "takeaways": {
      "type": "component",
      "repeatable": true,
      "component": "content.text-item",
      "required": true,
      "min": 3,
      "max": 3
    },
    "faqs": {
      "type": "component",
      "repeatable": true,
      "component": "content.faq"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "imageAlt": {
      "type": "string"
    },
    "sendsTo": {
      "type": "string",
      "required": true
    },
    "published": {
      "type": "date",
      "required": true
    },
    "updated": {
      "type": "date"
    },
    "readingMinutes": {
      "type": "integer",
      "min": 1
    },
    "author": {
      "type": "string",
      "default": "Hitasoft"
    }
  }
}
