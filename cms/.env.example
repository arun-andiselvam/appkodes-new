HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database. Unset (or DATABASE_CLIENT=sqlite) keeps the .tmp/data.db a
# laptop uses. Production sets DATABASE_CLIENT=postgres and the rest, per
# config/database.ts and the Deploying section of README.md.
DATABASE_CLIENT=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=

# Media storage. Unset keeps Strapi's local disk provider, which is fine on
# a laptop and does not survive a container restart everywhere else. Set
# SPACES_BUCKET (and the two keys below it) to switch to S3-compatible
# storage, per config/plugins.ts.
SPACES_BUCKET=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
# Defaults to nyc3 if unset. Only set these two if the bucket is not in
# nyc3, or sits behind a different S3-compatible endpoint entirely.
SPACES_REGION=
SPACES_ENDPOINT=
